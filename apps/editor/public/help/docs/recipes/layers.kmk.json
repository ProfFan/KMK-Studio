{
  "version": 1,
  "id": "docs-layers",
  "name": "Navigation under your fingertips",
  "layout": "mac",
  "timing": {
    "tapWindowMs": 250,
    "holdMs": 200
  },
  "layers": [
    {
      "id": "base",
      "name": "Base",
      "bindings": [
        {
          "id": "caps-nav",
          "key": "caps_lock",
          "behavior": {
            "type": "map",
            "action": {
              "type": "layer",
              "layer": "nav",
              "mode": "momentary"
            }
          }
        },
        {
          "id": "tab-toggle",
          "key": "tab",
          "behavior": {
            "type": "map",
            "action": {
              "type": "layer",
              "layer": "nav",
              "mode": "toggle"
            }
          }
        }
      ]
    },
    {
      "id": "nav",
      "name": "Navigation",
      "bindings": [
        {
          "id": "nav-h",
          "key": "h",
          "behavior": {
            "type": "map",
            "action": {
              "type": "key",
              "key": "left_arrow"
            }
          }
        },
        {
          "id": "nav-j",
          "key": "j",
          "behavior": {
            "type": "map",
            "action": {
              "type": "key",
              "key": "down_arrow"
            }
          }
        },
        {
          "id": "nav-k",
          "key": "k",
          "behavior": {
            "type": "map",
            "action": {
              "type": "key",
              "key": "up_arrow"
            }
          }
        },
        {
          "id": "nav-l",
          "key": "l",
          "behavior": {
            "type": "map",
            "action": {
              "type": "key",
              "key": "right_arrow"
            }
          }
        },
        {
          "id": "escape-base",
          "key": "escape",
          "behavior": {
            "type": "map",
            "action": {
              "type": "layer",
              "layer": "base",
              "mode": "set"
            }
          }
        }
      ]
    }
  ]
}
