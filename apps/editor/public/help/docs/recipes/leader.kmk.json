{
  "version": 1,
  "id": "docs-leader",
  "name": "Double Command, then a direction",
  "layout": "mac",
  "timing": {
    "tapWindowMs": 250,
    "holdMs": 200
  },
  "layers": [
    {
      "id": "base",
      "name": "Base",
      "bindings": [
        {
          "id": "command-leader",
          "key": "left_command",
          "behavior": {
            "type": "dance",
            "steps": [
              {
                "tap": {
                  "type": "block"
                },
                "hold": {
                  "type": "key",
                  "key": "left_command"
                }
              },
              {
                "tap": {
                  "type": "layer",
                  "layer": "nav",
                  "mode": "oneshot",
                  "timeoutMs": 1000
                },
                "hold": {
                  "type": "key",
                  "key": "left_command"
                }
              }
            ],
            "interruption": "hold"
          }
        }
      ]
    },
    {
      "id": "nav",
      "name": "Navigation",
      "bindings": [
        {
          "id": "nav-h",
          "key": "h",
          "behavior": {
            "type": "map",
            "action": {
              "type": "key",
              "key": "left_arrow"
            }
          }
        },
        {
          "id": "nav-j",
          "key": "j",
          "behavior": {
            "type": "map",
            "action": {
              "type": "key",
              "key": "down_arrow"
            }
          }
        },
        {
          "id": "nav-k",
          "key": "k",
          "behavior": {
            "type": "map",
            "action": {
              "type": "key",
              "key": "up_arrow"
            }
          }
        },
        {
          "id": "nav-l",
          "key": "l",
          "behavior": {
            "type": "map",
            "action": {
              "type": "key",
              "key": "right_arrow"
            }
          }
        }
      ]
    }
  ]
}
