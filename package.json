{
  "name": "kmk-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1 apps/editor",
    "build": "npm run typecheck && vite build apps/editor",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:native": "node --import tsx scripts/native-conformance.ts",
    "native:build": "bash scripts/build-native.sh",
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=.cache/playwright playwright test",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "docs:screenshots": "PLAYWRIGHT_BROWSERS_PATH=.cache/playwright node --import tsx scripts/capture-docs.ts",
    "kmk": "node --import tsx packages/cli/src/main.ts",
    "browser:install": "PLAYWRIGHT_BROWSERS_PATH=.cache/playwright playwright install chromium --only-shell",
    "format": "prettier --write packages apps/editor/src scripts tests docs README.md package.json tsconfig.json playwright.config.ts",
    "format:check": "prettier --check packages apps/editor/src scripts tests docs README.md package.json tsconfig.json playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
